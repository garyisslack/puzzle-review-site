{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://puzzle-review-site.local/schemas/guide.json",
  "title": "GuideDraft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "gameSlug",
    "title",
    "platform",
    "levelRange",
    "body",
    "contributorName",
    "status",
    "piiCleared"
  ],
  "properties": {
    "slug": { "type": "string", "minLength": 1 },
    "gameSlug": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["ios", "android"] },
    "levelRange": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 80 },
    "verifiedOnVersion": { "type": "string" },
    "verifiedBy": { "type": "string" },
    "contributorName": { "type": "string" },
    "status": { "enum": ["draft", "verified"] },
    "piiCleared": { "type": "boolean" },
    "publishedOn": { "type": "string", "format": "date" },
    "modifiedOn": { "type": "string", "format": "date" },
    "aiAssisted": { "type": "boolean" }
  }
}
