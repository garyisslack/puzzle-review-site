---
import { comparePair } from '@puzzle/seo'
import Base from '../../../layouts/Base.astro'
import Icon from '../../../components/Icon.astro'
import { colorSortSnapshot, crumbs, dimensionRows, publishedGuides, publishedReviews, reviewJson, similarSlugs } from '../../../lib/site.ts'
import { DIM_ICON, TAGS, artFor, scoreBand, storeCta, tagIcon, tagStateLabel, testedRange, weightedFormula } from '../../../lib/present.ts'

export function getStaticPaths() {
  return publishedReviews().map((review) => ({ params: { slug: review.slug } }))
}
const review = publishedReviews().find((item) => item.slug === Astro.params.slug)
if (!review) throw new Error('missing review')
const dims = dimensionRows(review.dims, review.rationales)
const similar = similarSlugs(review.slug).map((slug) => publishedReviews().find((item) => item.slug === slug)).filter((item) => item !== undefined)
const gameGuides = publishedGuides().filter((guide) => guide.gameSlug === review.slug)
const art = artFor(review.slug)
const band = scoreBand(review.displayed)
const snapshot = colorSortSnapshot()
const ranked = snapshot.ok ? snapshot.snapshot.items.find((item) => item.gameId === review.gameId) : undefined
const shots = review.publicEvidenceCount > 0
  ? [
      { src: '/media/shot-1.jpg', label: `Board · v${review.appVersion}` },
      { src: '/media/shot-2.jpg', label: `Level · ${review.testedTo}` },
      { src: '/media/shot-3.jpg', label: `Ad break · ${review.platform}` },
    ]
  : []
const jsonLd = [reviewJson(review.slug), crumbs([{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews/' }, { name: review.name, path: `/reviews/${review.slug}/` }])].filter(Boolean)
---
<Base title={`${review.name} review`} description={review.summary} path={`/reviews/${review.slug}/`} robots={review.sponsored ? 'noindex,follow' : 'index,follow'} jsonLd={jsonLd}>
  <main class="wrap">
    <figure class="key-art">
      {art.key ? <img src={art.key} alt="" width="1312" height="240" /> : <div class="placeholder"><Icon name="image" size={28} /></div>}
      <figcaption>Key art from the official store listing · © its developer (mockup: AI-generated stand-in)</figcaption>
    </figure>
    <section class="review-top">
      <div>
        <p class="crumbs"><a href="/">Home</a> / <a href="/reviews/">Reviews</a> / {review.mechanicFamily} / {review.name}</p>
        <div class="pills">
          <span class:list={['pill', review.reviewType === 'full' ? '' : 'muted']}><i class="dot"></i> {review.reviewType === 'full' ? 'FULL REVIEW' : 'INITIAL REVIEW'}</span>
          {review.sponsored && <span class="pill warn"><i class="dot"></i> SPONSORED</span>}
          <span class="pill warn"><i class="dot"></i> FICTIONAL DEMO DATA</span>
        </div>
        <div class="title-row">
          {art.icon ? <img class="app-icon" src={art.icon} alt="" width="88" height="88" /> : <span class="app-icon placeholder"><Icon name="image" size={28} /></span>}
          <h1>{review.name} review</h1>
        </div>
        <p class="dek">{review.verdict}</p>
        <div class="meta-grid">
          <div><span>PLATFORM</span><strong>{review.osVersion}</strong></div>
          <div><span>APP VERSION</span><strong>{review.appVersion}</strong></div>
          <div><span>TESTED</span><strong>{testedRange(review.testedFrom, review.testedTo)}</strong></div>
          <div><span>TESTER REGION</span><strong>{review.testerRegion}</strong></div>
          <div><span>STORE CHECKED</span><strong>{review.platform === 'ios' ? 'US App Store' : 'Google Play'}</strong></div>
        </div>
        <p class="byline"><span class="avatar">{review.authorName.slice(0, 1)}</span> By {review.authorName}</p>
        <div class="cta-row">
          <a class="store" href={review.storeUrl}>{storeCta(review.platform)} <Icon name="arrow-up-right" size={16} /></a>
        </div>
        <p class="leave"><Icon name="info" size={15} /> Opens the official store and leaves this site. Kids: ask a grown-up before buying anything.</p>
      </div>
      <aside class="score-panel">
        <div class="score-top">
          <div>
            <div class="k">EDITORIAL SCORE</div>
            <div class="score big">{review.displayed ?? '—'}</div>
          </div>
          <div class="score-side">
            {band && <span class="band-pill">{band}</span>}
            <span>{review.displayed ? 'OUT OF 10' : 'No composite score'}</span>
            <span>score-model-v1</span>
          </div>
        </div>
        <hr class="rule" />
        {dims.map((dim) => (
          <div class="dimbar">
            <span style={`color:var(--d${dim.key})`}><Icon name={DIM_ICON[dim.key]} size={18} /></span>
            <span class="label">{dim.label}</span>
            <span class="weight">{dim.weight}%</span>
            <span class="track"><span style={`width:${dim.width}%;background:var(--d${dim.key})`}></span></span>
            <span class="value">{dim.displayed ?? '—'}</span>
          </div>
        ))}
        <hr class="rule" />
        <p class="calc">{weightedFormula(dims, review.displayed)}</p>
        <p class="independence"><Icon name="shield-check" size={14} /> {review.sponsored ? 'Sponsored. This page is not a ranking and its numbers are excluded from every list.' : 'No sponsorship on this review. Ads never change scores.'}</p>
      </aside>
    </section>
    <section class="review-body">
      <div class="stack">
        <div class="verdict">
          <p class="eyebrow">VERDICT</p>
          <p>{review.summary}</p>
        </div>
        <div class="callout">
          <h2><Icon name="triangle-alert" size={18} /> Testing boundaries</h2>
          <p>{review.testingBoundaries}</p>
        </div>
        <div>
          <h2>Scores, dimension by dimension</h2>
          {dims.map((dim) => (
            <article class="dim-note">
              <div class="mark" style={`color:var(--d${dim.key})`}>{dim.key}<div>{dim.displayed ?? '—'}</div></div>
              <div>
                <h3>{dim.label} <span>{dim.weight}%</span></h3>
                <p>{dim.rationale || 'No rationale yet, so this dimension is not scored.'}</p>
              </div>
            </article>
          ))}
        </div>
        <figure>
          <div class="block-head"><h2>Screenshots from our test</h2></div>
          {shots.length > 0 ? (
            <div class="shots">
              {shots.map((shot) => (
                <figure class="shot">
                  <img src={shot.src} alt="" width="640" height="360" />
                  <figcaption>{shot.label}</figcaption>
                </figure>
              ))}
            </div>
          ) : <div class="thumb placeholder" style="width:100%;height:180px"><Icon name="image" size={22} /></div>}
          <figcaption class="shot-caption">Design mockup: these are AI-generated stand-ins for a fictional game. Real reviews show in-game captures with platform, version and date, credited to the developer.</figcaption>
        </figure>
        <div>
          <h2>Quick answers</h2>
          {review.faqs.map((faq) => <article class="faq"><h3>{faq.q}</h3><p>{faq.a}</p></article>)}
        </div>
        {gameGuides.length > 0 && <p><a class="text-link" href={`/guides/${review.slug}/`}>Community guides ({gameGuides.length}) <Icon name="arrow-right" size={16} /></a></p>}
      </div>
      <aside class="side">
        <div>
          <h2>PLAY CONDITIONS</h2>
          <div class="tag-list">
            {TAGS.map((tag) => {
              const state = review.tags[tag.key] ?? 'unknown'
              return (
                <span class:list={['chip', 'wide', state]}>
                  <Icon name={tagIcon(state)} size={14} />
                  {tag.label}
                  <b>{tagStateLabel(state)}</b>
                </span>
              )
            })}
          </div>
          <p class="tag-note">“No forced ads” doesn’t mean no ads at all. Tags never change the score.</p>
        </div>
        <div class="sun-card">
          <h2>Notes for parents</h2>
          <ul>
            {review.familyNotes.map((note) => {
              const split = note.indexOf(':')
              const label = split === -1 ? note : note.slice(0, split)
              const detail = split === -1 ? '' : note.slice(split + 1).trim()
              return <li><span>{label}</span>{detail}</li>
            })}
          </ul>
          <p>Facts we observed, not a kids’ app certification. Check the store listing and your device’s parental controls.</p>
        </div>
        <div class="side-card">
          <h2>WHERE IT RANKS</h2>
          {ranked ? (
            <p><strong>#{ranked.rank}</strong> on {snapshot.ok ? 'the iOS color-sort list' : 'this list'} · {review.displayed}</p>
          ) : <p>Not on the numbered iOS color-sort list.</p>}
          <p class="meta">iOS and Android are never combined. A missing score cannot be ranked.</p>
        </div>
        {similar.length > 0 && (
          <div>
            <h2>SIMILAR GAMES WE’VE FULLY REVIEWED</h2>
            {similar.slice(0, 3).map((item) => (
              <div class="similar">
                <a href={`/reviews/${item.slug}/`}><strong>{item.name}</strong><br /><span class="meta">{item.displayed}</span></a>
                <a class="text-link" href={`/compare/${comparePair(review.slug, item.slug).canonicalSlug}/`}>Compare</a>
              </div>
            ))}
          </div>
        )}
        <div>
          <h2>DISCLOSURE</h2>
          <p class="tag-note">Store links go to official listings only. We have no affiliate deal with this developer. Ads, affiliates and sponsorships never change scores or ranks.</p>
        </div>
      </aside>
    </section>
  </main>
</Base>
