---
import Base from '../../../layouts/Base.astro'
import { crumbs, dimensionRows, publishedGuides, publishedReviews, reviewJson, similarSlugs } from '../../../lib/site.ts'
export function getStaticPaths() {
  return publishedReviews().map((review) => ({ params: { slug: review.slug } }))
}
const review = publishedReviews().find((item) => item.slug === Astro.params.slug)
if (!review) throw new Error('missing review')
const dims = dimensionRows(review.dims, review.rationales)
const similar = similarSlugs(review.slug).map((slug) => publishedReviews().find((item) => item.slug === slug)).filter((item) => item !== undefined)
const gameGuides = publishedGuides().filter((guide) => guide.gameSlug === review.slug)
const jsonLd = [reviewJson(review.slug), crumbs([{ name: 'Home', path: '/' }, { name: 'Reviews', path: '/reviews/' }, { name: review.name, path: `/reviews/${review.slug}/` }])].filter(Boolean)
---
<Base title={`${review.name} review`} description={review.summary} path={`/reviews/${review.slug}/`} robots={review.sponsored ? 'noindex,follow' : 'index,follow'} jsonLd={jsonLd}>
  <main class="wrap">
    {review.sponsored && <p class="banner">Sponsored. This page is not a ranking and its numbers are excluded from every list.</p>}
    <p class="meta">Home / Reviews / {review.name}</p>
    <p class="kicker">{review.reviewType === 'full' ? 'FULL REVIEW' : 'INITIAL NOTES'} · {review.mechanicFamily}</p>
    <div class="split">
      <div>
        <h1>{review.name} review</h1>
        <p class="lede">{review.verdict}</p>
        <p class="meta">{review.platform.toUpperCase()} · {review.appVersion} · Tested {review.testedFrom} to {review.testedTo} · {review.osVersion}</p>
        <p><a class="btn" href={review.storeUrl}>View on the {review.platform === 'ios' ? 'App Store' : 'Google Play'}</a></p>
      </div>
      <aside class="card">
        <p class="meta">EDITORIAL SCORE</p>
        <p class="score big">{review.displayed ?? '—'}</p>
        <p class="meta">{review.displayed ? 'out of 10' : 'No composite score. A missing dimension is never shown as 0 or 10.'}</p>
        {dims.map((dim) => (
          <div class="dim">
            <span>{dim.label}</span>
            <span class="track"><span style={`width:${dim.width}%;background:var(--d${dim.key})`}></span></span>
            <strong>{dim.displayed ?? '—'}</strong>
          </div>
        ))}
      </aside>
    </div>
    <section class="section">
      <h2>Verdict</h2>
      <p>{review.summary}</p>
      <div class="banner"><strong>Testing boundaries.</strong> {review.testingBoundaries}</div>
    </section>
    <section class="section split">
      <div>
        <h2>Play variations</h2>
        {Object.entries(review.tags).map(([tag, state]) => <p class={`pill ${state}`}>{state === 'yes' ? 'Yes' : state === 'no' ? 'No' : 'Not sure'} · {tag.replaceAll('_', ' ')}</p>)}
      </div>
      <aside class="card">
        <h2>Notes for parents</h2>
        {review.familyNotes.map((note) => <p>{note}</p>)}
      </aside>
    </section>
    <section class="section">
      <h2>Scores, dimension by dimension</h2>
      {dims.map((dim) => <article><h3>{dim.label} {dim.displayed ?? 'not scored'}</h3><p>{dim.rationale || 'No rationale yet, so this dimension is not scored.'}</p></article>)}
    </section>
    <section class="section">
      <h2>Screenshots from our test</h2>
      <div class="shots">
        <div class="shot">IMG:key-art · {review.appVersion}<img alt="" width="640" height="360" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==" /></div>
        <div class="shot">IMG:board · {review.testedTo}</div>
        <div class="shot">IMG:ad-break · {review.platform}</div>
      </div>
    </section>
    {gameGuides.length > 0 && <p><a href={`/guides/${review.slug}/`}>Community guides ({gameGuides.length})</a></p>}
    {similar.length > 0 && <p>Similar: {similar.map((item) => <a href={`/reviews/${item.slug}/`}>{item.name} {item.displayed}</a>)} </p>}
    <section class="section">
      <h2>Quick answers</h2>
      {review.faqs.map((faq) => <article><h3>{faq.q}</h3><p>{faq.a}</p></article>)}
    </section>
  </main>
</Base>
