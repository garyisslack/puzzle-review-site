---
import ReviewDirectory from '../../../components/ReviewDirectory.astro'
import { reviewPageCount } from '../../../lib/site.ts'

export function getStaticPaths() {
  return Array.from({ length: reviewPageCount() - 1 }, (_, index) => ({
    params: { page: String(index + 2) }, props: { page: index + 2 },
  }))
}
---
<ReviewDirectory page={Astro.props.page} />
