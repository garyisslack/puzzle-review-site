---
import Base from '../layouts/Base.astro'
import ResearchRow from '../components/ResearchRow.astro'
import Icon from '../components/Icon.astro'
import { organizationJsonLd, websiteJsonLd } from '@puzzle/seo'
import { SITE_NAME, SITE_URL, crumbs, publishedReviews } from '../lib/site.ts'

const reviews = publishedReviews()
const latest = [...reviews].sort((a, b) => b.publishedOn.localeCompare(a.publishedOn) || (a.chartRank ?? 999) - (b.chartRank ?? 999)).slice(0, 6)
const jsonLd = [organizationJsonLd({ siteUrl: SITE_URL, name: SITE_NAME }), websiteJsonLd({ siteUrl: SITE_URL, name: SITE_NAME }), crumbs([{ name: 'Home', path: '/' }])]
---
<Base title="Puzzle game research before you download" description="Explore US puzzle game store analyses and player-review digests. Clearly labeled sources, ad reports and evidence limits, without untested editorial scores." path="/" jsonLd={jsonLd}>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-kicker"><i></i> PUZZLE GAME RESEARCH · iOS & ANDROID</p>
        <h1>Find puzzle games worth playing — before you download.</h1>
        <p class="lede">Explore US store listings and player-review digests. We separate published claims from player reports and clearly label what has not been playtested.</p>
        <div class="hero-ctas">
          <a class="btn" href="/reviews/">Browse game research <Icon name="arrow-right" size={16} /></a>
          <a class="btn ghost" href="/how-we-test/">Our evidence</a>
        </div>
      </div>
    </section>
    <section class="wrap latest">
      <div>
        <div class="block-head"><h2>Latest game research</h2><a class="text-link" href="/reviews/">All research →</a></div>
        {latest.map((review) => <ResearchRow review={review} />)}
        <p class="ledger-note">Research notes do not receive an editorial score or enter numeric rankings.</p>
      </div>
      <aside class="genres">
        <div class="block-head"><h2>Before you download</h2></div>
        <div class="genre-row"><div><a href="/reviews/"><strong>Browse all research</strong></a><span>{reviews.length} game research notes</span></div></div>
        <div class="genre-row"><div><a href="/how-we-test/"><strong>Our evidence</strong></a><span>Store claims and player reports</span></div></div>
        <div class="genre-row"><div><strong>Hands-on testing</strong><span>No published playtests yet</span></div></div>
        <div class="genre-row"><div><a href="/how-we-test/#formula"><strong>Scoring method</strong></a><span>Reserved for hands-on reviews</span></div></div>
        <div class="genre-row"><div><a href="/editorial-independence/"><strong>Editorial independence</strong></a><span>How we handle sponsorship</span></div></div>
      </aside>
    </section>
  </main>
</Base>
