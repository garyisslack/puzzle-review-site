---
import '@fontsource/nunito/700.css'
import '@fontsource/nunito/800.css'
import '@fontsource/nunito-sans/400.css'
import '@fontsource/nunito-sans/500.css'
import '@fontsource/nunito-sans/700.css'
import '@fontsource/nunito-sans/800.css'
import '../styles/global.css'
import Icon from '../components/Icon.astro'
import { metaDescription } from '@puzzle/seo'
import { SITE_NAME, SITE_URL, primaryRankingSlug } from '../lib/site.ts'

interface Props {
  title: string
  description: string
  path: string
  robots?: string
  image?: string
  jsonLd?: unknown[]
}
const { title, description, path, robots = 'index,follow', image, jsonLd = [] } = Astro.props
const canonical = new URL(path, SITE_URL).toString()
const pageTitle = title.includes(SITE_NAME) ? title : `${title} · ${SITE_NAME}`
const summary = metaDescription(description)
const imageUrl = image ? new URL(image, SITE_URL).toString() : ''
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={summary} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={summary} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {jsonLd.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <header class="nav">
      <div class="nav-row">
        <a class="brand" href="/">
          <img class="mark" src="/mark.svg" alt="" width="32" height="32" />
          <img class="wordmark" src="/wordmark.svg" alt={SITE_NAME} width="248" height="36" />
        </a>
        <nav class="nav-links" id="site-nav">
          <a href="/#needs">Discover</a>
          <a href={`/rankings/${primaryRankingSlug}/`}>Rankings</a>
          <a href="/reviews/">Reviews</a>
          <a href="/guides/prism-pocket-sort/">Guides</a>
          <a href="/#updates">New & Updated</a>
        </nav>
        <form class="search" action="/reviews/" method="get">
          <Icon name="search" size={16} />
          <input name="q" type="search" placeholder="Search games" aria-label="Search games" />
        </form>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <Icon name="menu" size={22} />
          <span class="hidden">Menu</span>
        </button>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-row">
          <div>
            <div class="footer-brand-row">
              <img class="mark" src="/mark.svg" alt="" width="28" height="28" />
              <img class="wordmark" src="/wordmark-dark.svg" alt={SITE_NAME} width="214" height="31" />
            </div>
            <p>Independent editorial scores for iOS & Android casual and puzzle games.</p>
          </div>
          <nav>
            <a href="/how-we-test/">How We Test</a>
            <a href="/editorial-independence/">Editorial independence</a>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        </div>
        <hr class="footer-rule" />
        <p class="footer-note">Editorial rankings are not US App Store or Google Play download charts. Ads, affiliates and sponsorships never change scores or ranks.</p>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle')
      const links = document.querySelector('.nav-links')
      const search = document.querySelector('.search')
      toggle?.addEventListener('click', () => {
        const open = links?.classList.toggle('is-open')
        search?.classList.toggle('is-open', Boolean(open))
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false')
      })
    </script>
  </body>
</html>
