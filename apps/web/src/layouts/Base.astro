---
import '@fontsource/nunito/700.css'
import '@fontsource/nunito/800.css'
import '@fontsource/nunito-sans/400.css'
import '@fontsource/nunito-sans/500.css'
import '@fontsource/nunito-sans/700.css'
import '@fontsource/nunito-sans/800.css'
import '../styles/global.css'
import Icon from '../components/Icon.astro'
import { SITE_NAME, SITE_URL } from '../lib/site.ts'

interface Props {
  title: string
  description: string
  path: string
  robots?: string
  jsonLd?: unknown[]
}
const { title, description, path, robots = 'index,follow', jsonLd = [] } = Astro.props
const canonical = new URL(path, SITE_URL).toString()
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {jsonLd.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <header class="nav">
      <div class="nav-row">
        <a class="brand" href="/">
          <span class="wordmark">{SITE_NAME}</span>
        </a>
        <nav class="nav-links" id="site-nav">
          <a href="/#needs">Discover</a>
          <a href="/rankings/color-sort-ios/">Rankings</a>
          <a href="/reviews/">Reviews</a>
          <a href="/guides/prism-pocket-sort/">Guides</a>
          <a href="/#updates">New & Updated</a>
        </nav>
        <form class="search" action="/reviews/" method="get">
          <Icon name="search" size={16} />
          <input name="q" type="search" placeholder="Search games" aria-label="Search games" />
        </form>
        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
          <Icon name="menu" size={22} />
          <span class="hidden">Menu</span>
        </button>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-row">
          <div>
            <strong class="footer-brand">{SITE_NAME}</strong>
            <p>Independent editorial scores for iOS & Android casual and puzzle games.</p>
          </div>
          <nav>
            <a href="/how-we-test/">How We Test</a>
            <a href="/editorial-independence/">Editorial independence</a>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        </div>
        <hr class="footer-rule" />
        <p class="footer-note">Editorial rankings are not US App Store or Google Play download charts. Ads, affiliates and sponsorships never change scores or ranks.</p>
      </div>
    </footer>
    <script>
      const toggle = document.querySelector('.nav-toggle')
      const links = document.querySelector('.nav-links')
      const search = document.querySelector('.search')
      toggle?.addEventListener('click', () => {
        const open = links?.classList.toggle('is-open')
        search?.classList.toggle('is-open', Boolean(open))
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false')
      })
    </script>
  </body>
</html>
