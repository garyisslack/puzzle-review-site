---
import '@fontsource/nunito/700.css'
import '@fontsource/nunito/800.css'
import '@fontsource/nunito-sans/400.css'
import '@fontsource/nunito-sans/700.css'
import '../styles/global.css'
import { SITE_NAME, SITE_URL } from '../lib/site.ts'

interface Props {
  title: string
  description: string
  path: string
  robots?: string
  jsonLd?: unknown[]
}
const { title, description, path, robots = 'index,follow', jsonLd = [] } = Astro.props
const canonical = new URL(path, SITE_URL).toString()
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {jsonLd.map((node) => <script type="application/ld+json" set:html={JSON.stringify(node)} />)}
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-row">
        <a class="brand" href="/">{SITE_NAME}<small>BRAND TBD</small></a>
        <nav class="nav-links">
          <a href="/#needs">Discover</a>
          <a href="/rankings/color-sort-ios/">Rankings</a>
          <a href="/reviews/">Reviews</a>
          <a href="/guides/prism-pocket-sort/">Guides</a>
          <a href="/how-we-test/">How we test</a>
        </nav>
        <form action="/reviews/" method="get">
          <input class="search" name="q" type="search" placeholder="Search games" aria-label="Search games" />
        </form>
      </div>
    </header>
    <slot />
    <footer class="footer">
      <div class="wrap">
        <div class="footer-row">
          <div>
            <strong>{SITE_NAME}</strong>
            <p>Independent editorial scores for US iOS and Android casual and puzzle games.</p>
          </div>
          <nav>
            <a href="/how-we-test/">How We Test</a>
            <a href="/editorial-independence/">Editorial independence</a>
            <a href="/about/">About</a>
            <a href="/contact/">Contact</a>
            <a href="/privacy/">Privacy</a>
          </nav>
        </div>
        <p class="meta">Editorial rankings are not US App Store or Google Play download charts. Ads, affiliates, and sponsorships never change scores or ranks.</p>
      </div>
    </footer>
  </body>
</html>
