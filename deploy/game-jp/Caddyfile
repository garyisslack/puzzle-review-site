{
	auto_https off
	admin off
}

# 测评站静态前台（Astro dist）
:5210 {
	root * /opt/dimpuzzle/current
	encode gzip zstd

	# Tunnel 到源站始终为 HTTP，使用 Cloudflare 传递的原始协议判断。
	@alternateHost host www.puzzlereviewlab.com
	redir @alternateHost https://puzzlereviewlab.com{uri} 301
	@insecure header X-Forwarded-Proto http
	redir @insecure https://puzzlereviewlab.com{uri} 301

	@indexHtml path_regexp indexHtml ^(.*)/index\.html$
	redir @indexHtml https://puzzlereviewlab.com{re.indexHtml.1}/ 301
	import /opt/dimpuzzle/current/seo-redirects.caddy

	# 部署配置不是公开资源。
	@private path /seo-redirects.caddy /_redirects /_headers /Caddyfile
	handle @private {
		respond 404
	}

	@static path *.css *.js *.woff2 *.png *.jpg *.jpeg *.webp *.avif *.ico
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@sitemap path /sitemap.xml /sitemap-reviews.xml /sitemap-rankings.xml /sitemap-pages.xml /robots.txt
	handle @sitemap {
		header Cache-Control "public, max-age=3600"
		file_server
	}

	@query expression `{http.request.uri.query} != ""`
	header @query X-Robots-Tag "noindex, follow"

	handle {
		try_files {path} {path}/ {path}/index.html
		file_server
	}
}

# Payload CMS（后续启用：pnpm start on 5211）
:5211 {
	reverse_proxy 127.0.0.1:3000
}
