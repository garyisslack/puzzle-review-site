# 测评站静态前台（Astro dist）
:5210 {
	root * /opt/dimpuzzle/current
	encode gzip zstd

	@static path *.css *.js *.woff2 *.png *.webp *.avif *.ico *.txt *.xml
	handle @static {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		try_files {path} {path}/ {path}/index.html
		file_server
	}
}

