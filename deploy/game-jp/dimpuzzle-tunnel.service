[Unit]
Description=Cloudflare Tunnel for DimPuzzle
After=network-online.target dimpuzzle-static.service
Wants=network-online.target

[Service]
EnvironmentFile=-/etc/dimpuzzle/tunnel.env
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token ${TUNNEL_TOKEN}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
